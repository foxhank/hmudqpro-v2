    "login.error.jwcDownHint" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This error means the JWC system itself failed. All of the app's requests go straight to the JWC server, so when it's down we can't get in either.\nThat said, the JWC acts up often — try again in a little while?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个报错是因为教务系统本身出错了。百湖医大小助手所有请求都直接请求教务系统，所以教务崩溃咱们也用不了。\n不过教务经常抽风，等一会儿试试呢？"
          }
        }
      }
    },
